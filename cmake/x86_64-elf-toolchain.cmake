set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(TOOLCHAIN_PREFIX "$ENV{HOME}/Catacomb/opt/toolchain")

set(CMAKE_C_COMPILER "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-gcc")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-g++")

set(CMAKE_AR "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-ar")
set(CMAKE_RANLIB "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-ranlib")
set(CMAKE_OBJCOPY "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-objcopy")
set(CMAKE_OBJDUMP "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-objdump")
set(CMAKE_READELF "${TOOLCHAIN_PREFIX}/bin/x86_64-elf-readelf")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH "${TOOLCHAIN_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
